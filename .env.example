# Public site identity. Both must be set before going live (stack.py doctor checks).
SITE_DOMAIN=acadadviser.com
CONTACT_EMAIL=

# Cookies only travel over HTTPS. Set false only when testing on http://127.0.0.1.
COOKIE_SECURE=true

# Spend guards. Every search and follow-up is a paid model run.
# The IP limit covers free searches only. The global limit counts every search and follow-up.
SEARCHES_PER_IP_PER_DAY=5
MODEL_RUNS_PER_DAY=50
# Refinements per search: subscribers, then the free search. Then the subscribers' fair-use cap.
FOLLOW_UPS_PER_SEARCH=8
FREE_FOLLOW_UPS=3
SEARCHES_PER_USER_PER_DAY=15

# Sign-in. The gateway verifies Cognito ID tokens itself.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Billing. Use sk_test_ keys until the launch checklist in README.md is done.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PLAN_PRICE_LABEL=$99 per year

# api_key is required for a public site. chatgpt_oauth is for private local testing only.
PSA_AUTH_MODE=api_key
